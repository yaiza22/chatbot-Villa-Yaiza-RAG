# Plantilla de configuración del bot de Telegram.
# Copia este archivo como .env en la raíz del repositorio y llena los valores.
# El archivo .env no se sube a Git porque guarda el token del bot.

# Token que entrega @BotFather (obligatorio).
TELEGRAM_BOT_TOKEN=

# Motor del bot: M0, M1, M2, M3 o clasificador+redactor (M0+M3, M0+M2, M1+M2, M1+M3).
BOT_ENGINE=M0+M3

# Chat que recibe las consultas escaladas (obtenlo con /miid). Vacío = sin avisos.
ADMIN_CHAT_ID=

# Solo si el motor usa M1 o M2, que se entrenan al arrancar (valores por defecto):
# BOT_TRAIN_INPUT=data/processed/labeled.csv
# BOT_TRAIN_SOURCE=real

# Segundos máximos de espera a Ollama por respuesta; si se pasa, la consulta escala.
# BOT_LLM_TIMEOUT_S=60

# Usa el modelo de embeddings ya descargado sin consultar Hugging Face al arrancar.
# HF_HUB_OFFLINE=1
